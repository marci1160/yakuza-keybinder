; Datei aus Base64 in den Temp-Ordner schreiben (nur wenn noetig) und
; den Pfad liefern.
YkAssets_File(name) {
    dir := A_Temp . "\YakuzaKeybinder"
    path := dir . "\" . name
    b64 := (name = "yakuza.ico") ? YkAssets_Icon() : YkAssets_Header()
    size := 0
    DllCall("crypt32\CryptStringToBinaryW", "Str", b64, "UInt", 0, "UInt", 1, "Ptr", 0, "UIntP", size, "Ptr", 0, "Ptr", 0)
    FileGetSize, have, %path%
    if (FileExist(path) && have = size)
        return path
    FileCreateDir, %dir%
    VarSetCapacity(bin, size, 0)
    if !DllCall("crypt32\CryptStringToBinaryW", "Str", b64, "UInt", 0, "UInt", 1, "Ptr", &bin, "UIntP", size, "Ptr", 0, "Ptr", 0)
        return ""
    f := FileOpen(path, "w")
    if (!IsObject(f))
        return ""
    f.RawWrite(&bin, size)
    f.Close()
    return path
}
