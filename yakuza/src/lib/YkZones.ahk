global YK_ZonesArr := []
global YK_CitiesArr := []
global YK_ZonesReady := false

YkZone_Init() {
    global YK_ZonesArr, YK_CitiesArr, YK_ZonesReady
    if (YK_ZonesReady)
        return
    YkZone_Load()
    YK_ZonesReady := true
}

YkZone_GetZone(x, y, z) {
    global YK_ZonesArr
    YkZone_Init()
    for i, o in YK_ZonesArr {
        if (x >= o.x1 && y >= o.y1 && z >= o.z1 && x <= o.x2 && y <= o.y2 && z <= o.z2)
            return o.name
    }
    return ""
}

YkZone_GetCity(x, y, z) {
    global YK_CitiesArr
    YkZone_Init()
    best := ""
    bestSize := 0
    for i, o in YK_CitiesArr {
        if (x >= o.x1 && y >= o.y1 && z >= o.z1 && x <= o.x2 && y <= o.y2 && z <= o.z2) {
            sz := (o.x2 - o.x1) * (o.y2 - o.y1) * (o.z2 - o.z1)
            if (best = "" || sz < bestSize) {
                best := o.name
                bestSize := sz
            }
        }
    }
    return best
}

